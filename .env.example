# Infisical base URL. For this project, your self-hosted instance is:
INFISICAL_BASE_URL=https://infisical-bfi.blueforceinnovations.com

# Use one of the two auth modes below.

# Option 1: Token Auth / API-key-like Machine Identity token.
INFISICAL_TOKEN=
# INFISICAL_API_KEY is accepted as an alias for INFISICAL_TOKEN.

# Option 2: Universal Auth. The server logs in and caches the returned bearer token.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_ORGANIZATION_SLUG=

# Optional defaults used by tools when an argument is omitted.
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/

# Runtime behavior.
INFISICAL_TIMEOUT_SECONDS=30
INFISICAL_VERIFY_TLS=true

# FastMCP transport. stdio is best for local MCP clients; http is useful in Docker.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

